# Server
PORT=3000

# Instagram Graph API — Business Discovery
# Requires ONE Instagram Business/Creator account linked to a Meta app.
# That account's IG user ID + a long-lived User/Page access token with
# instagram_basic, pages_read_engagement, and business_discovery permissions.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional: Behold.so (or similar) JSON feed URL as an alternative source
BEHOLD_FEED_URL=
